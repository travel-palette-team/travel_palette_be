// 이거는 예시임 각자 파일에 .env 파일 생성
# ==========================================
# Database (MySQL 8.4)
# ==========================================
DB_HOST=localhost
DB_PORT=3306
DB_NAME=travel_palette
DB_USERNAME=root
DB_PASSWORD=your_mysql_password

# ==========================================
# Backend Server (Java 25 / Spring Boot)
# ==========================================
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=local

# AI 서버 연동 주소 (travel_palette_ai)
AI_SERVER_URL=http://localhost:8000

# ==========================================
# External Open APIs (여행경보 & 환율)
# ==========================================
MOFA_API_BASE_URL=http://apis.data.go.kr/1262000
MOFA_API_SERVICE_KEY=your_data_go_kr_decoding_key

EXCHANGE_API_BASE_URL=https://www.koreaexim.go.kr/site/program/financial/exchangeJSON
EXCHANGE_API_KEY=your_exchange_api_authkey